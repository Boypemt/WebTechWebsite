# ─────────────────────────────────────────────
# .env.example — safe to commit, no real secrets
# Copy this file to .env and fill in the values
# ─────────────────────────────────────────────

# Server
PORT=3000

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES=24h

# bcrypt cost factor (10 = ~100 ms per hash)
BCRYPT_ROUNDS=10

# SQLite database file path
DB_PATH=store.db

# Product Service base URL (simulated microservice)
PRODUCT_SERVICE_URL=http://localhost:3000/api/products

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000
